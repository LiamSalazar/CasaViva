# Django
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings.development
DATABASE_URL=postgresql://casaviva_app:CHANGE_ME@127.0.0.1:5432/casaviva
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
ENABLE_TECHNICAL_ADMIN=false
ANTIBOT_ENABLED=false
DB_SSL_REQUIRE=false
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_CUSTOM_DOMAIN=
MEDIA_REMOTE_HOSTNAME=

# PostgreSQL local. Sustituye los valores CHANGE_ME antes de iniciar.
POSTGRES_DB=casaviva
POSTGRES_HOST_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
CASAVIVA_APP_PASSWORD=CHANGE_ME
CASAVIVA_MIGRATOR_PASSWORD=CHANGE_ME
CASAVIVA_READONLY_PASSWORD=CHANGE_ME
CASAVIVA_BACKUP_PASSWORD=CHANGE_ME

# Frontend / reverse proxy local
DJANGO_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Fundadores: opcionales; bootstrap_founders los solicita si hay terminal interactiva.
LIAM_NAME=
LIAM_EMAIL=
LIAM_PASSWORD=
ANA_EMAIL=
ANA_PASSWORD=
ALFREDO_EMAIL=
ALFREDO_PASSWORD=
